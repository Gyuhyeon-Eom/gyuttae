{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gyeote-app",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-20",
  "account_id": "a57b51f32c8d50f90c4f30debb508aa7",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{"pattern":"app.tridatum.co","custom_domain":true}],
  "assets": {"directory":"./static","binding":"ASSETS","run_worker_first":["/api/*"]},
  "durable_objects": {"bindings":[{"name":"CHAT","class_name":"ChatStore"}]},
  "migrations":[{"tag":"v1","new_sqlite_classes":["ChatStore"]}],
  "vars":{"MODEL":"claude-sonnet-5","DAILY_LIMIT":"100"},
  "observability":{"enabled":false}
}
